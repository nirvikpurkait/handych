{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "remoteCache": { "enabled": true },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/*.stories.tsx",
        "!**/*.stories.ts",
        "!**/*.stories.jsx",
        "!**/*.stories.js",
        "!**/.storybook/**"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
